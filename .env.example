SERVER_ENV=development
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
SERVER_ADDRESS=http://localhost:3000
SERVER_DOCUMENT_PATH=api

JWT_SECRET=super_secret_jwt_key_change_in_prod
JWT_EXP=86400
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key
JWT_REFRESH_EXP=604800

SQL_TYPE=postgres
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=postgres
SQL_SCHEMA=public
SQL_DB=aisoft_db
SQL_MAX_POOL=20

MONGODB_URI=mongodb://localhost:27017/aisoft_mongo
MONGODB_NAME=aisoft_mongo

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aisoft-files

MICROSERVICE_GRPC_HOST=0.0.0.0
MICROSERVICE_GRPC_PORT=3001
MICROSERVICE_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
